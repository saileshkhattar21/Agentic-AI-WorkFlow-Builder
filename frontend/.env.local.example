# Copy this file to .env.local and adjust if your local URLs differ.
# These match the confirmed-working local service URLs from the backend summary.
# IMPORTANT: the GraphQL URL is local.hasura.local.nhost.run, NOT local.graphql.local.nhost.run
# (that host double-appends /graphql and fails - see known-bugs list).

NEXT_PUBLIC_NHOST_AUTH_URL=https://local.auth.local.nhost.run/v1
NEXT_PUBLIC_NHOST_STORAGE_URL=https://local.storage.local.nhost.run/v1
NEXT_PUBLIC_NHOST_FUNCTIONS_URL=https://local.functions.local.nhost.run/v1
NEXT_PUBLIC_NHOST_GRAPHQL_URL=https://local.hasura.local.nhost.run/v1/graphql
